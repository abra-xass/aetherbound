<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asset packs + update downloads from GitHub Releases -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- One-click APK install from inside the app (user still confirms once) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="Aetherbound"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">

        <activity
            android:name="com.aetherbound.game.GamePreviewActivity"
            android:exported="true"
            android:label="Aetherbound"
            android:screenOrientation="sensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Thot integration: open Aetherbound directly into multiplayer flows.
                 Thot's AetherbroundLauncher fires these with room_id + peer_matrix_id
                 + invite_event_id extras. See docs/multiplayer-thot-binding.md. -->
            <intent-filter>
                <action android:name="io.aether.action.OPEN_TITLE" />
                <action android:name="io.aether.action.BATTLE_INVITE" />
                <action android:name="io.aether.action.TRADE_OFFER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver for cross-app battle-event relay from Thot.
             Thot decodes io.aether.battle.* events from Matrix and forwards
             them here via package-targeted broadcasts. exported=true is
             required for cross-app delivery; payload is non-privileged JSON
             validated by the deterministic resolver downstream. -->
        <receiver
            android:name="com.aetherbound.game.core.data.BattleRelayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.aether.action.BATTLE_RELAY" />
            </intent-filter>
        </receiver>

        <!-- FileProvider so we can hand a downloaded APK to Android's package installer
             without exposing internal file paths. Required for REQUEST_INSTALL_PACKAGES. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
