<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Downloaded update APK lives here so the FileProvider can grant a URI
         to Android's package installer without leaking absolute paths. -->
    <external-files-path name="updates" path="updates/" />
    <files-path name="cache_updates" path="updates/" />
    <cache-path name="cache" path="." />
</paths>
