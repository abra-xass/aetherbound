{
    "schema_version":  1,
    "rule":  "Each Echoform sprite has base animation states; final art can use sprite sheets, Spine-like bones, or Compose canvas, but state names stay stable.",
    "states":  [
                   "idle",
                   "walk_down",
                   "walk_up",
                   "walk_left",
                   "walk_right",
                   "battle_idle",
                   "attack_ready",
                   "hit_react",
                   "low_vigor",
                   "faint",
                   "attune_success",
                   "level_up",
                   "ascend",
                   "fusion_start",
                   "fusion_idle",
                   "fusion_end"
               ],
    "timing":  {
                   "idle_ms":  1200,
                   "walk_cycle_ms":  520,
                   "hit_react_ms":  360,
                   "faint_ms":  780,
                   "battle_idle_ms":  900,
                   "fusion_start_ms":  1100
               },
    "per_echoform_rule":  "E001-E300 use the same state list with species-specific silhouette offset, breathing amplitude, eye blink timing, and element particle overlay.",
