# Aetherbound — release signing config (local dev)
#
# Copy this file to `keystore.properties` and fill in real values.
# The real `keystore.properties` is gitignored — never commit it.
#
# Generate the keystore once with:
#   keytool -genkey -v -keystore aetherbound-release.keystore \
#     -alias aetherbound -keyalg RSA -keysize 4096 -validity 10000
#
# CRITICAL: Backup the keystore file in multiple secure locations.
# Without it you can never publish updates that overwrite installs
# of earlier-signed APKs.

AETHER_KEYSTORE_PATH=../keys/aetherbound-release.keystore
AETHER_KEYSTORE_PASS=replace-me
AETHER_KEY_ALIAS=aetherbound
AETHER_KEY_PASS=replace-me
